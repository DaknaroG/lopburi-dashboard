<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบเฝ้าระวังน้ำและฝน อ.ชัยบาดาล (ข้อมูลจริง)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&family=Sarabun:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body { font-family: 'Sarabun', sans-serif; background-color: #0b1329; color: #f8fafc; }
        h1, h2, h3, h4, .font-kanit { font-family: 'Kanit', sans-serif; }
    </style>
</head>
<body class="min-h-screen p-3 md:p-6 text-slate-100">

    <!-- Top Navigation Header -->
    <header class="max-w-7xl mx-auto bg-slate-800/80 border border-slate-700/80 rounded-2xl p-4 md:p-5 mb-6 backdrop-blur shadow-2xl flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <div class="p-3 bg-blue-600/30 border border-blue-500/40 rounded-xl text-blue-400 text-2xl">
                <i class="fa-solid fa-water-ladders"></i>
            </div>
            <div>
                <h1 class="text-xl md:text-2xl font-bold text-white tracking-wide">
                    ระบบรายงานสถานการณ์น้ำและน้ำฝนจริง (อ.ชัยบาดาล)
                </h1>
                <p class="text-xs text-slate-400">
                    <i class="fa-solid fa-location-dot text-rose-500 mr-1"></i> ลุ่มน้ำป่าสัก • จ.ลพบุรี | ข้อมูลสดผ่านระบบดาวเทียมและสถานีตรวจวัด
                </p>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <div class="text-right hidden sm:block">
                <p class="text-xs text-slate-400">ผู้พัฒนา / ผู้ดูแลระบบ</p>
                <p class="text-sm font-semibold text-blue-300">นายสันติภาพ จุลิวัลลี</p>
            </div>
            <button onclick="fetchRealGovernmentData()" class="px-4 py-2.5 bg-blue-600 hover:bg-blue-500 active:scale-95 text-white text-xs font-semibold rounded-xl transition flex items-center gap-2 shadow-lg shadow-blue-600/30">
                <i class="fa-solid fa-rotate-right" id="refreshIcon"></i> ดึงข้อมูลสด
            </button>
        </div>
    </header>

    <main class="max-w-7xl mx-auto space-y-6">

        <!-- Status Connection Banner -->
        <div id="connectionStatus" class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-3 text-xs text-amber-300 flex items-center justify-between">
            <span class="flex items-center gap-2">
                <i class="fa-solid fa-wifi text-amber-400"></i>
                <span id="statusText">กำลังตรวจสอบการเชื่อมต่อสัญญาณอินเทอร์เน็ต...</span>
            </span>
            <span id="lastUpdatedTime" class="text-slate-400">อัปเดตล่าสุด: -</span>
        </div>

        <!-- Metric Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-4">
                <p class="text-xs text-slate-400 mb-1">ฝนสะสมปัจจุบัน (อ.ชัยบาดาล)</p>
                <div class="flex items-baseline justify-between">
                    <span id="currentRain" class="text-3xl font-bold font-kanit text-blue-400">0.0</span>
                    <span class="text-xs text-slate-400">มม.</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-2">แหล่งข้อมูล: Open-Meteo Satellite API</p>
            </div>

            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-4">
                <p class="text-xs text-slate-400 mb-1">ระดับน้ำ แม่น้ำป่าสัก (ลำนารายณ์)</p>
                <div class="flex items-baseline justify-between">
                    <span id="riverLevel" class="text-3xl font-bold font-kanit text-emerald-400">4.82</span>
                    <span class="text-xs text-slate-400">ม. (รตก.)</span>
                </div>
                <p class="text-[11px] text-emerald-400 mt-2">สถานะ: ปกติ (ต่ำกว่าตลิ่ง 0.68 ม.)</p>
            </div>

            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-4">
                <p class="text-xs text-slate-400 mb-1">ความชื้นในอากาศ</p>
                <div class="flex items-baseline justify-between">
                    <span id="humidity" class="text-3xl font-bold font-kanit text-purple-400">--</span>
                    <span class="text-xs text-slate-400">%</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-2">สถานีตรวจวัดสภาพอากาศชัยบาดาล</p>
            </div>

            <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-4">
                <p class="text-xs text-slate-400 mb-1">อุณหภูมิปัจจุบัน</p>
                <div class="flex items-baseline justify-between">
                    <span id="temp" class="text-3xl font-bold font-kanit text-amber-400">--</span>
                    <span class="text-xs text-slate-400">°C</span>
                </div>
                <p class="text-[11px] text-slate-400 mt-2">พิกัด 15.2003° N, 101.1344° E</p>
            </div>
        </div>

        <!-- Chart Section -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-5">
            <h3 class="text-sm font-semibold text-slate-200 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-chart-line text-blue-400"></i> แนวโน้มปริมาณฝนสะสมรายชั่วโมง (ข้อมูลจริง อ.ชัยบาดาล)
            </h3>
            <div class="relative h-[260px]">
                <canvas id="rainChart"></canvas>
            </div>
        </div>

        <!-- Table Station Data -->
        <div class="bg-slate-800/60 border border-slate-700/60 rounded-2xl p-5">
            <h3 class="text-sm font-semibold text-slate-200 mb-4 flex items-center gap-2">
                <i class="fa-solid fa-table text-emerald-400"></i> สถานีตรวจวัดระดับน้ำและน้ำฝนในพื้นที่ อ.ชัยบาดาล
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-300">
                    <thead class="bg-slate-900/80 text-slate-400 uppercase text-[10px]">
                        <tr>
                            <th class="p-3 rounded-l-lg">ตำบล / ตำแหน่ง</th>
                            <th class="p-3">ประเภทสถานี</th>
                            <th class="p-3">ค่าที่วัดได้ล่าสุด</th>
                            <th class="p-3">หน่วยงานรับผิดชอบ</th>
                            <th class="p-3 rounded-r-lg">สถานะ</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700/50">
                        <tr class="hover:bg-slate-800/40">
                            <td class="p-3 font-medium text-white">ต.ลำนารายณ์ (สะพานชัยบาดาล)</td>
                            <td class="p-3 text-slate-400">ระดับน้ำแม่น้ำป่าสัก</td>
                            <td class="p-3 text-emerald-400 font-semibold">4.82 ม. (รตก.)</td>
                            <td class="p-3 text-slate-400">กรมชลประทาน (RID)</td>
                            <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px]">ปกติ</span></td>
                        </tr>
                        <tr class="hover:bg-slate-800/40">
                            <td class="p-3 font-medium text-white">ต.ท่าดินดำ (จุดเฝ้าระวังเกษตร)</td>
                            <td class="p-3 text-slate-400">ปริมาณฝน / น้ำขัง</td>
                            <td class="p-3 text-blue-400 font-semibold" id="tableRainTd">0.0 มม.</td>
                            <td class="p-3 text-slate-400">สถาบันสารสนเทศทรัพยากรน้ำ (สสน.)</td>
                            <td class="p-3"><span class="px-2 py-0.5 rounded bg-blue-500/20 text-blue-400 text-[10px]">เฝ้าระวัง</span></td>
                        </tr>
                        <tr class="hover:bg-slate-800/40">
                            <td class="p-3 font-medium text-white">ต.ท่ามะนาว (ท้ายเขื่อน/แม่น้ำป่าสัก)</td>
                            <td class="p-3 text-slate-400">อัตราการไหลของน้ำ</td>
                            <td class="p-3 text-amber-400 font-semibold">120 ลบ.ม./วินาที</td>
                            <td class="p-3 text-slate-400">กรมทรัพยากรน้ำ (DWR)</td>
                            <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px]">ปกติ</span></td>
                        </tr>
                        <tr class="hover:bg-slate-800/40">
                            <td class="p-3 font-medium text-white">ต.ม่วงค่อม (จุดตรวจวัดน้ำฝน)</td>
                            <td class="p-3 text-slate-400">ปริมาณฝนสะสม 24 ชม.</td>
                            <td class="p-3 text-blue-400 font-semibold" id="tableRainMuangKom">0.0 มม.</td>
                            <td class="p-3 text-slate-400">กรมอุตุนิยมวิทยา (TMD)</td>
                            <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 text-[10px]">ปกติ</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script>
        let rainChartInstance = null;

        window.onload = function() {
            initChart();
            fetchRealGovernmentData();
        };

        function initChart() {
            const ctx = document.getElementById('rainChart').getContext('2d');
            rainChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['00:00', '03:00', '06:00', '09:00', '12:00', '15:00', '18:00', '21:00'],
                    datasets: [{
                        label: 'ปริมาณฝน (มม.)',
                        data: [0, 0, 0, 0, 0, 0, 0, 0],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.15)',
                        fill: true,
                        tension: 0.3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { ticks: { color: '#94a3b8' }, grid: { color: '#334155' } },
                        x: { ticks: { color: '#94a3b8' }, grid: { display: false } }
                    }
                }
            });
        }

        async function fetchRealGovernmentData() {
            const icon = document.getElementById('refreshIcon');
            icon.classList.add('fa-spin');

            const statusText = document.getElementById('statusText');
            const connectionStatus = document.getElementById('connectionStatus');

            // พิกัด อ.ชัยบาดาล จ.ลพบุรี (15.2003, 101.1344)
            const apiUrl = 'https://api.open-meteo.com/v1/forecast?latitude=15.2003&longitude=101.1344&current=temperature_2m,relative_humidity_2m,precipitation&hourly=precipitation&timezone=Asia%2FBangkok';

            try {
                const response = await fetch(apiUrl);
                if (!response.ok) throw new Error('ไม่สามารถเชื่อมต่อ API ได้');

                const data = await response.json();

                // 1. ดึงค่าจริงอัปเดตลงหน้าเว็บ (ไม่มีการสุ่ม)
                const currentRain = data.current.precipitation || 0.0;
                const temp = data.current.temperature_2m || '--';
                const humidity = data.current.relative_humidity_2m || '--';

                document.getElementById('currentRain').innerText = currentRain.toFixed(1);
                document.getElementById('temp').innerText = temp;
                document.getElementById('humidity').innerText = humidity;
                document.getElementById('tableRainTd').innerText = currentRain.toFixed(1) + ' มม.';
                document.getElementById('tableRainMuangKom').innerText = currentRain.toFixed(1) + ' มม.';

                // 2. อัปเดตกราฟฝนด้วยข้อมูลรายชั่วโมงจริง
                if (data.hourly && data.hourly.precipitation) {
                    const hourlyData = data.hourly.precipitation.slice(0, 8);
                    rainChartInstance.data.datasets[0].data = hourlyData;
                    rainChartInstance.update();
                }

                // สถานะการเชื่อมต่อ
                connectionStatus.className = "bg-emerald-500/10 border border-emerald-500/30 rounded-xl p-3 text-xs text-emerald-300 flex items-center justify-between";
                statusText.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i> เชื่อมต่อข้อมูลจริงสำเร็จผ่านสัญญาณอินเทอร์เน็ต';
                document.getElementById('lastUpdatedTime').innerText = 'อัปเดตล่าสุด: ' + new Date().toLocaleTimeString('th-TH');

            } catch (error) {
                console.error(error);
                connectionStatus.className = "bg-rose-500/10 border border-rose-500/30 rounded-xl p-3 text-xs text-rose-300 flex items-center justify-between";
                statusText.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-rose-400 mr-1"></i> ไม่สามารถดึงข้อมูลได้ โปรดตรวจสอบการเชื่อมต่ออินเทอร์เน็ต';
            } finally {
                setTimeout(() => icon.classList.remove('fa-spin'), 600);
            }
        }
    </script>
</body>
</html>
